# Copy to .env and fill in. See README.md for the full list of options.

# --- required -------------------------------------------------------------
# Postgres connection string for the miniflux database. Miniflux's Postgres
# usually isn't published outside its Docker network, so from a workstation
# this often means tunnelling to it first (see README.md).
DB_URL=postgres://user:password@localhost:5432/miniflux?sslmode=disable

# Your miniflux instance, linked from the site header.
APP_URL=https://miniflux.example.com

# --- required to publish (not needed for `make build`) --------------------
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Leave S3_ENDPOINT_URL unset for AWS S3. For an S3-compatible provider, set
# it — e.g. https://nyc3.digitaloceanspaces.com (DigitalOcean Spaces),
# https://<account>.r2.cloudflarestorage.com (Cloudflare R2), or a MinIO host.
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1

# --- optional -------------------------------------------------------------
# Chat link shown in the site header. Omit it and the link isn't rendered.
# CHAT_URL=

# REFRESH_INTERVAL_SECONDS=3600
# S3_PREFIX=
# S3_DELETE_ORPHANS=true
