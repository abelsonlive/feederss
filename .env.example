# Copy to .env and fill in. See README.md for the full list of options.

# --- required -------------------------------------------------------------
# Postgres connection string for the miniflux database. Miniflux's Postgres
# isn't published outside its Docker network, so from a laptop this usually
# means tunnelling to it first (see README.md).
DB_URL=postgres://user:password@localhost:5432/miniflux?sslmode=disable

# Your miniflux instance, linked from the site header.
APP_URL=https://rss.abelson.live

# Where the header's chat icon points.
CHAT_URL=

# --- required to publish (not needed for `make build`) --------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=feederss
S3_REGION=nyc3

# --- optional -------------------------------------------------------------
# REFRESH_INTERVAL_SECONDS=3600
# S3_PREFIX=
# S3_DELETE_ORPHANS=true
